# --- LLM ---------------------------------------------------------------------
# Which LLMClient implementation to use. Options:
#   echo        - offline stub, no key, no real answers (tests / first run)
#   claude      - Anthropic API (paid); reads ANTHROPIC_API_KEY / `ant auth login`
#   groq        - FREE key at https://console.groq.com  (fast Llama models)
#   gemini      - FREE key at https://aistudio.google.com/apikey
#   openrouter  - FREE key at https://openrouter.ai/keys (use a ":free" model)
#   cerebras    - FREE key at https://cloud.cerebras.ai
#   openai      - generic OpenAI-compatible endpoint (set LLM_BASE_URL); also
#                 works with local servers like Ollama (http://localhost:11434/v1)
LLM_PROVIDER=echo

# Model id. Leave as-is for "claude"; for the free providers you may leave it and
# a sensible default is picked, or set one explicitly, e.g.
#   groq:       openai/gpt-oss-20b     (run `python -m scripts.check_llm` to list yours)
#   gemini:     gemini-2.0-flash
#   openrouter: meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL=claude-opus-5

# Key for the free / OpenAI-compatible providers (groq, gemini, openrouter, ...).
LLM_API_KEY=
# Only for LLM_PROVIDER=openai: the API root, e.g. http://localhost:11434/v1
LLM_BASE_URL=

# Only for LLM_PROVIDER=claude. Blank = use `ant auth login`.
ANTHROPIC_API_KEY=

# --- Speech to text --------------------------------------------------------
# faster-whisper model name, e.g. tiny.en, base.en, small.en, medium.en.
WHISPER_MODEL=base.en

# --- Retrieval (RAG) -----------------------------------------------------------
EMBED_MODEL=all-MiniLM-L6-v2
# Number of chunks retrieved per question.
TOP_K=4
# Minimum cosine similarity for a chunk to be considered relevant (0..1).
MIN_SCORE=0.15
# Character budget for section-aware chunking.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Question detection ------------------------------------------------------
# When true, borderline utterances are confirmed with a single yes/no LLM call.
QUESTION_LLM_FALLBACK=false

# --- Utterance assembly ----------------------------------------------------
# Silence gap (seconds) between transcript chunks that forces an utterance flush.
UTTERANCE_GAP_S=1.2
# Hard character cap that forces an utterance flush.
UTTERANCE_MAX_CHARS=400

# --- Storage & CORS ---------------------------------------------------------
# Where persisted vector stores are written.
DATA_DIR=./data
# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# --- Zoom App (free, development-mode side panel) --------------------------
# CSP frame-ancestors allowed to embed the panel. Default covers the Zoom client.
ZOOM_FRAME_ANCESTORS='self' https://*.zoom.us https://*.zoomgov.com
# The public HTTPS URL the app is reached at (your cloudflared/ngrok tunnel).
# Informational only - logged at startup so you can copy it into the Zoom app.
PUBLIC_BASE_URL=
